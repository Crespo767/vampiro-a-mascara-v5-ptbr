{{!-- VtM5e Character Sheet Reskin - Ghoul Header
      Ghouls (per wod5e's own GhoulActorSheet) only ever surface Health,
      Willpower, Humanity, and Domitor - no Bane/Compulsion/Predator/
      Resonance/Rouse-Frenzy, since none of those apply. Mirrors the Vampire
      header's identity-row-then-stats-row layout, just narrower. --}}
<header class="actor-header cs-header cs-tracks-header" {{#if headerbg}} style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="cs-header-row">
        <div class="cs-header-identity">
            {{> "systems/wod5e/display/shared/actors/parts/header-profile.hbs"}}
            <div class="cs-domitor-field">
                <span class="cs-domitor-label" data-tooltip="O vampiro que alimenta você com sua vitae e o vincula a ele como carniçal." data-tooltip-direction="DOWN">{{localize "WOD5E.VTM.Domitor"}}:</span>
                <input class="cs-domitor-input" type="text" name="system.headers.domitor" value="{{domitor}}" placeholder="{{localize 'WOD5E.VTM.Domitor'}}"/>
            </div>
        </div>
    </div>

    <div class="cs-header-stats">
        <div class="cs-stat-row">
            <div class="cs-stat cs-stat-health">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=health track="health" path="system.health" label=(localize "WOD5E.Health") editable=canEditHeader}}
            </div>
            <div class="cs-stat cs-stat-willpower">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=willpower track="willpower" path="system.willpower" label=(localize "WOD5E.Willpower") editable=canEditHeader canRoll=true}}
            </div>
            <div class="cs-stat cs-stat-humanity">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-humanity.hbs" humanity=humanity editable=canEditHeader tooltip="Quanto da moral mortal você ainda preserva; Humanidade baixa aumenta o risco de Máculas e de se perder."}}
            </div>
        </div>
    </div>
</header>
