{{!-- Cabeçalho de Personagem do Narrador: cópia do wod5e com as trilhas do cabeçalho de Vampiro. --}}
<header class="actor-header cs-tracks-header" {{#if headerbg}} style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="header-fields">
        <div class="header-fields-left">
            <div class="cs-stat cs-stat-health">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=health track="health" path="system.health" label=(localize "WOD5E.Health") editable=canEditHeader}}
            </div>

            <div class="cs-stat cs-stat-willpower">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=willpower track="willpower" path="system.willpower" label=(localize "WOD5E.Willpower") editable=canEditHeader canRoll=true}}
            </div>
        </div>
    </div>
    <!-- Middle of the header -->
    {{> "systems/wod5e/display/shared/actors/parts/header-profile.hbs"}}
    <div class="header-fields">
        <div class="header-fields-right">
            <div class="flexcol">
                {{#if generalDifficultyEnabled}}
                    {{> "systems/wod5e/display/shared/actors/parts/spc/generaldifficulty.hbs"}}
                {{/if}}

                {{#ifeq currentActorType 'vampire'}}
                    <div class="flexrow field-section">
                        <div class="flexcol">
                            <label class="resource-label field-header">{{localize 'WOD5E.VTM.Hunger'}}</label>
                            {{> "systems/wod5e/display/vtm/actors/parts/hunger.hbs"}}
                        </div>
                        {{> "systems/wod5e/display/shared/actors/parts/spc/blood-potency.hbs"}}
                    </div>
                {{/ifeq}}

                {{#ifeq currentActorType 'hunter'}}
                    <div class="field-section">
                        <div class="flexcol">
                            <label class="resource-label field-header">{{localize 'WOD5E.HTR.Despair'}}</label>
                            {{> "systems/wod5e/display/htr/actors/parts/despair.hbs"}}
                        </div>
                    </div>
                {{/ifeq}}

                {{#ifeq currentActorType 'werewolf'}}
                    <div class="field-section">
                        <div class="flexcol">
                            <label class="resource-label field-header">{{localize 'WOD5E.WTA.Rage'}}</label>
                            {{> "systems/wod5e/display/wta/actors/parts/rage-value.hbs"}}
                        </div>
                    </div>
                {{/ifeq}}

                {{#ifeq currentActorType 'spirit'}}
                    <div class="field-section">
                        <div class="flexcol">
                            <!-- Power Dicepool -->
                            <div class="flexcol flex-center">
                                <a class="field-header flexrow resource-label rollable" for="{{localize 'WOD5E.WTA.Power'}}" data-action="roll" data-use-absolute-value="true"
                                    data-absolute-value="{{power.value}}" data-label="{{localize 'WOD5E.WTA.Power'}}"
                                    {{#if noAdvancedDice}} data-disable-advanced-dice="true"{{/if}}>
                                    {{localize 'WOD5E.WTA.Power'}}
                                    <i class="fa-solid fa-dice-d10"></i>
                                </a>
                                {{#if locked}}
                                    <div class="resource stat-resource-background">
                                        {{power.value}}
                                    </div>
                                {{else}}
                                    <input type="number" name="system.power.value" value="{{power.value}}" data-dtype="Number"/>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                {{/ifeq}}
            </div>
        </div>
    </div>
</header>
