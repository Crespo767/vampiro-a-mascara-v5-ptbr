{{!-- VtM5e Character Sheet Reskin - Header --}}
{{#*inline "vampireHeaderDots"}}
    <div class="resource-value cs-header-dots" data-value="{{value}}" data-name="{{path}}" data-track="{{track}}">
        {{#numLoop max}}
            <span class="resource-value-step{{#if ../isHunger}} hunger-value{{/if}}" data-action="dotCounterChange" data-index="{{this}}"
                data-tooltip="Clique direito para remover 1 ponto"></span>
        {{/numLoop}}
    </div>
{{/inline}}
<header class="actor-header cs-header cs-tracks-header" {{#if headerbg}} style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="cs-header-row">
        <div class="cs-header-identity">
            {{> "systems/wod5e/display/shared/actors/parts/header-profile.hbs"}}
            <div class="cs-header-subtitle">
                <button type="button" class="cs-header-choice{{#unless clan}} cs-header-choice-empty{{/unless}}"
                    data-action="chooseHeaderItem" data-type="clan" {{#unless canEditHeader}}disabled{{/unless}}
                    {{#if clan}}data-tooltip-html="{{clanDescription}}" data-tooltip-direction="DOWN"{{/if}}>
                    {{#if clan}}{{clan.name}}{{else}}Selecionar Clã{{/if}}
                </button>
                &bull;
                <button type="button" class="cs-header-choice{{#unless predator}} cs-header-choice-empty{{/unless}}"
                    data-action="chooseHeaderItem" data-type="predatorType" {{#unless canEditHeader}}disabled{{/unless}}
                    {{#if predator}}data-tooltip-html="{{predatorDescription}}" data-tooltip-direction="DOWN"{{/if}}>
                    {{#if predator}}{{predator.name}}{{else}}Selecionar Predador{{/if}}
                </button>
            </div>
        </div>

        <div class="cs-header-topright">
            <div class="cs-bane-compulsion cs-mottled-bg">
                <div class="cs-bc-line">
                    <span class="cs-bc-label">{{localize "WOD5E.VTM.ClanBane"}}:</span>
                    {{#if baneName}}
                        <span class="cs-bc-value{{#unless bane}} cs-bc-none{{/unless}}" {{#if bane}}data-tooltip-html="{{bane}}" data-tooltip-direction="DOWN"{{/if}}>{{baneName}}</span>
                    {{else}}
                        <span class="cs-bc-value cs-bc-none">{{#if clan}}Não cadastrada{{else}}Selecione um clã{{/if}}</span>
                    {{/if}}
                </div>
                <div class="cs-bc-line">
                    <span class="cs-bc-label">Compulsão:</span>
                    <select class="cs-bc-select" name="flags.vampiro-a-mascara-v5-ptbr.compulsion" aria-label="Compulsão"
                        {{#unless canEditHeader}}disabled{{/unless}}
                        {{#if compulsionText}}data-tooltip-html="{{compulsionText}}" data-tooltip-direction="DOWN"{{/if}}>
                        <option value="">Nenhuma</option>
                        {{#each compulsionOptions as |opt|}}
                            <option value="{{opt.value}}"{{#if opt.selected}} selected{{/if}}>{{opt.label}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>
            <div class="cs-quickrolls">
                <button class="rollable rouse-button cs-roll-badge" data-action="rouseCheck" type="button" name="rouse"
                    {{#unless canEditHeader}}disabled{{/unless}}
                    data-disable-basic-dice="true" data-use-absolute-value="true" data-absolute-value="1"
                    data-label="{{localize 'WOD5E.VTM.RousingBlood'}}" data-increase-hunger="true" data-difficulty="1" data-selectors="rouse"
                    title="{{localize 'WOD5E.VTM.RollRouse'}}"
                    data-tooltip="Faça uma Checagem de Sangue para ativar uma Disciplina ou despertar para a noite; em uma falha, ganhe 1 de Fome." data-tooltip-direction="DOWN">
                    <span class="cs-roll-badge-line1">Checagem</span>
                    <span class="cs-roll-badge-line2">de Sangue</span>
                </button>
                {{#if frenzyActive}}
                    <button class="vampire-button end-frenzy cs-roll-badge" data-action="endFrenzy" type="button"
                        {{#unless canEditHeader}}disabled{{/unless}}
                        name="endfrenzy" title="{{localize 'WOD5E.VTM.EndFrenzy'}}"
                        data-tooltip="Encerra o frenesi ativo depois que o motivo que o provocou passou." data-tooltip-direction="DOWN">
                        <span class="cs-roll-badge-line1">Encerrar</span>
                        <span class="cs-roll-badge-line2">Frenesi</span>
                    </button>
                {{else}}
                    <button class="vampire-button frenzy-roll cs-roll-badge" data-action="resistFrenzy" type="button"
                        {{#unless canEditHeader}}disabled{{/unless}}
                        name="resistfrenzy" title="{{localize 'WOD5E.VTM.ResistFrenzy'}}"
                        data-tooltip="Teste para não perder o controle para a Besta quando provocado, faminto ou diante de fogo ou luz do sol." data-tooltip-direction="DOWN">
                        <span class="cs-roll-badge-line1">Testar</span>
                        <span class="cs-roll-badge-line2">Frenesi</span>
                    </button>
                {{/if}}
            </div>
        </div>
    </div>

    {{!-- 2 rows x 3 columns, sitting full-width below the identity/bane row:
          Health | Humanity | Blood Potency
          Willpower | Hunger | Blood Resonance --}}
    <div class="cs-header-stats">
        <div class="cs-stat-row">
            <div class="cs-stat cs-stat-health">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=health track="health" path="system.health" label=(localize "WOD5E.Health") editable=canEditHeader}}
            </div>
            <div class="cs-stat cs-stat-humanity">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-humanity.hbs" humanity=humanity editable=canEditHeader tooltip="Quanto da moral mortal você ainda preserva contra a Besta; Humanidade baixa aumenta o risco de Máculas e frenesi."}}
            </div>
            <div class="cs-stat cs-stat-potency">
                <label class="resource-label field-header" data-tooltip="A força e a idade da sua vitae; Potência do Sangue maior fortalece as Disciplinas, mas agrava a Perdição e o custo em Fome." data-tooltip-direction="DOWN">{{localize "WOD5E.VTM.BloodPotency"}}</label>
                {{> vampireHeaderDots value=blood.potency max=10 path="system.blood.potency" track="potency"}}
            </div>
        </div>
        <div class="cs-stat-row">
            <div class="cs-stat cs-stat-willpower">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=willpower track="willpower" path="system.willpower" label=(localize "WOD5E.Willpower") editable=canEditHeader canRoll=true}}
            </div>
            <div class="cs-stat cs-stat-hunger">
                <label class="resource-label field-header" data-tooltip="O tamanho da sede de sangue da Besta; Fome maior põe mais dados de Fome nas rolagens e aumenta o risco de Falha Bestial." data-tooltip-direction="UP">{{localize "WOD5E.VTM.Hunger"}}</label>
                {{> vampireHeaderDots value=hunger.value max=hunger.max path="system.hunger.value" isHunger=true track="hunger"}}
            </div>
            <div class="cs-stat cs-stat-resonance">
                <label class="resource-label field-header" data-tooltip="O sabor que a alimentação deixa em você; pode conceder um dado de bônus a uma Disciplina correspondente." data-tooltip-direction="UP">{{localize "WOD5E.VTM.BloodResonance"}}</label>
                <button type="button" class="cs-resonance-value{{#unless resonance}} cs-resonance-none{{/unless}}" data-action="editResonance"
                    aria-label="Editar Ressonância do Sangue" title="Editar Ressonância do Sangue"
                    {{#unless canEditHeader}}disabled{{/unless}}
                    {{#if resonanceDescription}}data-tooltip-html="{{resonanceDescription}}" data-tooltip-direction="UP"{{/if}}>
                    {{#if resonance}}{{resonance.name}}{{else}}Nenhuma{{/if}}
                </button>
            </div>
        </div>
    </div>
</header>
