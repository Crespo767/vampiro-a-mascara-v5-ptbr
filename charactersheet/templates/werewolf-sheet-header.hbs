{{!-- VtM5e Character Sheet Reskin - Werewolf Header
      Health/Willpower/Rage in the stats row (Rage gets an inline roll icon
      next to its label, same treatment as Ghoul's Humanity/remorse-roll).
      Tribe/Auspice live in the header's topright box, same slot Vampire uses
      for Bane/Compulsion - reusing wod5e's own dynamic-item-display partial
      (search/add when empty, name+edit-pencil when set) rather than
      Vampire's custom clickable-span+tooltip treatment, since Tribe/Auspice
      don't have the same hover-description content built up for them yet. --}}
<header class="actor-header cs-header cs-tracks-header" {{#if headerbg}} style="background: url({{headerbg}}) center;"{{/if}}>
    <div class="cs-header-row">
        <div class="cs-header-identity">
            {{> "systems/wod5e/display/shared/actors/parts/header-profile.hbs"}}
        </div>

        <div class="cs-header-topright">
            <div class="cs-bane-compulsion cs-mottled-bg">
                <div class="cs-bc-line">
                    <span class="cs-bc-label" data-tooltip="Sua tribo: a família espiritual e a identidade cultural da sua matilha entre os Garou." data-tooltip-direction="DOWN">{{localize "WOD5E.WTA.Tribe"}}:</span>
                    <span class="cs-bc-value-wrap">
                        {{#if tribe}}<span class="data-item nowrap">{{tribe.name}}</span><a class="edit-data-item" data-action="itemEdit" data-item-id="{{tribe.id}}"><i class="fa-solid fa-pen-nib"></i></a>{{else}}<a class="add-data-item" data-action="createItem" data-type="tribe"><i class="fa-solid fa-plus"></i></a>{{/if}}
                    </span>
                </div>
                <div class="cs-bc-line">
                    <span class="cs-bc-label" data-tooltip="A fase da lua sob a qual você nasceu: molda seu papel e seu primeiro Dom." data-tooltip-direction="DOWN">{{localize "WOD5E.WTA.Auspice"}}:</span>
                    <span class="cs-bc-value-wrap">
                        {{#if auspice}}<span class="data-item nowrap">{{auspice.name}}</span><a class="edit-data-item" data-action="itemEdit" data-item-id="{{auspice.id}}"><i class="fa-solid fa-pen-nib"></i></a>{{else}}<a class="add-data-item" data-action="createItem" data-type="auspice"><i class="fa-solid fa-plus"></i></a>{{/if}}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="cs-header-stats">
        <div class="cs-stat-row">
            <div class="cs-stat-health">
                <div class="cs-stat">
                    {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=health track="health" path="system.health" label=(localize "WOD5E.Health") editable=canEditHeader}}
                </div>
                {{#ifeq activeForm "crinos"}}
                    <div class="resource-counter editable crinos-health" data-states="/:superficial,x:aggravated" data-max="{{crinosHealth.max}}"
                        data-superficial="{{crinosHealth.superficial}}" data-aggravated="{{crinosHealth.aggravated}}"
                        data-name="system.crinosHealth" data-tooltip="Vitalidade em Crinos">
                        {{#numLoop crinosHealth.max}}
                            <span class="resource-counter-step" data-index="{{this}}" data-state=""></span>
                        {{/numLoop}}
                    </div>
                {{/ifeq}}
            </div>
            <div class="cs-stat cs-stat-willpower">
                {{> "modules/vampiro-a-mascara-v5-ptbr/charactersheet/templates/header-damage-track.hbs" resource=willpower track="willpower" path="system.willpower" label=(localize "WOD5E.Willpower") editable=canEditHeader canRoll=true}}
            </div>
            <div class="cs-stat cs-stat-rage">
                <label class="resource-label field-header" data-tooltip="Sua fúria e seu poder sobrenatural: gaste Fúria para mudar de forma ou ativar Dons, mas, se ela cair demais, você corre o risco de perder o lobo." data-tooltip-direction="UP">
                    {{localize "WOD5E.WTA.Rage"}}
                    {{> "systems/wod5e/display/wta/actors/parts/rage-button.hbs"}}
                </label>
                {{> "systems/wod5e/display/wta/actors/parts/rage-value.hbs"}}
            </div>
        </div>
    </div>
</header>
