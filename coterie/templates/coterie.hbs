{{!-- VtM5e Coterie - desktop party sheet. Tab visibility is handled in JS
      (CoterieApplication#syncActiveTab), not Handlebars conditionals - every
      panel renders each pass, [data-tab-content] just gets hidden.
      Chasse/Lien/Portillon dots appear twice on purpose (compact header +
      full detail in the Domain tab) - both read the same fresh context
      every render, so there's no risk of the two views disagreeing. --}}
<div class="vtm5e-coterie-shell">
    <header class="vtm5e-coterie-header">
        <h1 class="vtm5e-coterie-title" {{#if isGM}}data-action="editName" data-editable="true"{{/if}}>
            {{coterieName}}
            {{#if isGM}}<i class="fas fa-pen vtm5e-coterie-title-edit"></i>{{/if}}
        </h1>
    </header>

    <div class="vtm5e-coterie-trackers">
        {{#each trackers as |tracker|}}
            <div class="vtm5e-coterie-tracker" title="{{tracker.tooltip}}">
                <span class="vtm5e-coterie-tracker-label">{{tracker.label}}</span>
                <div class="vtm5e-coterie-tracker-dots">
                    {{#each tracker.dots as |dot|}}
                        <span class="vtm5e-coterie-tracker-dot {{#if dot.active}}active{{/if}}"
                              {{#if ../../isGM}}data-action="setTracker" data-tracker-key="{{../tracker.key}}" data-index="{{dot.index}}"{{/if}}></span>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </div>
    {{#each trackers as |tracker|}}
        {{#if tracker.huntingDifficulty}}
            <div class="vtm5e-coterie-hunting-difficulty">Dificuldade de Caça: {{tracker.huntingDifficulty}}</div>
        {{/if}}
    {{/each}}

    <nav class="vtm5e-coterie-tabs">
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="members">Membros</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="domain">Domínio</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="backgrounds">Antecedentes</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="meritsFlaws">Qualidades e Defeitos</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="equipment">Equipamento</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="notes">Notas</button>
        <button type="button" class="vtm5e-coterie-tab-btn" data-action="switchTab" data-tab-button="wishlist">Lista de Desejos</button>
    </nav>

    <section class="vtm5e-coterie-tab-content" data-tab-content="members">
        {{#if isGM}}
            <button type="button" class="vtm5e-coterie-add-btn" data-action="addMember"><i class="fas fa-plus"></i> Adicionar Membro</button>
        {{/if}}
        {{#if members.length}}
            <div class="vtm5e-coterie-member-list">
                {{#each members as |member|}}
                    <div class="vtm5e-coterie-member-row">
                        <img class="vtm5e-coterie-member-portrait" src="{{member.img}}" alt="{{member.name}}">
                        <div class="vtm5e-coterie-member-info">
                            <span class="vtm5e-coterie-member-name">{{member.name}}</span>
                            <div class="vtm5e-coterie-resources">
                                {{#if member.healthBoxes}}
                                    <div class="vtm5e-coterie-resource-row">
                                        <span class="vtm5e-coterie-resource-label">Vitalidade</span>
                                        <div class="vtm5e-coterie-box-row">
                                            {{#each member.healthBoxes as |box|}}
                                                <span class="vtm5e-coterie-box vtm5e-coterie-box--{{box.state}}"></span>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{/if}}
                                {{#if member.willpowerBoxes}}
                                    <div class="vtm5e-coterie-resource-row">
                                        <span class="vtm5e-coterie-resource-label">Força de Vontade</span>
                                        <div class="vtm5e-coterie-box-row">
                                            {{#each member.willpowerBoxes as |box|}}
                                                <span class="vtm5e-coterie-box vtm5e-coterie-box--{{box.state}}"></span>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                        <span class="vtm5e-coterie-member-type">{{member.type}}</span>
                        <div class="vtm5e-coterie-member-actions">
                            <a data-action="openActorSheet" data-actor-uuid="{{member.uuid}}" title="Abrir ficha">
                                <i class="fas fa-user"></i>
                            </a>
                            {{#if ../isGM}}
                                <a data-action="removeMember" data-actor-uuid="{{member.uuid}}" title="Remover da coterie">
                                    <i class="fas fa-trash"></i>
                                </a>
                            {{/if}}
                        </div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <p class="vtm5e-coterie-empty">Ainda não há membros.{{#if isGM}} Clique em "Adicionar Membro" para começar.{{/if}}</p>
        {{/if}}
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="domain" hidden>
        <div class="vtm5e-coterie-field-row">
            <label class="vtm5e-coterie-field-label">Tipo de Coterie</label>
            <input type="text" class="vtm5e-coterie-text-input" data-field="coterieType" value="{{coterieType}}"
                   placeholder="Culto de Sangue, Campeões, Cérbero, Gangue das Presas, Nômades..." {{#unless isGM}}readonly{{/unless}}>
        </div>

        {{#each trackers as |tracker|}}
            <div class="vtm5e-coterie-domain-trait">
                <div class="vtm5e-coterie-domain-trait-header">
                    <span class="vtm5e-coterie-tracker-label">{{tracker.label}}</span>
                    <div class="vtm5e-coterie-tracker-dots">
                        {{#each tracker.dots as |dot|}}
                            <span class="vtm5e-coterie-tracker-dot {{#if dot.active}}active{{/if}}"
                                  {{#if ../../isGM}}data-action="setTracker" data-tracker-key="{{../tracker.key}}" data-index="{{dot.index}}"{{/if}}></span>
                        {{/each}}
                    </div>
                    {{#if tracker.huntingDifficulty}}<span class="vtm5e-coterie-hunting-difficulty-inline">Dificuldade de Caça {{tracker.huntingDifficulty}}</span>{{/if}}
                </div>
                <p class="vtm5e-coterie-domain-trait-desc">{{tracker.tooltip}}</p>
            </div>
        {{/each}}

        <div class="vtm5e-coterie-field-row vtm5e-coterie-field-row--stacked">
            <label class="vtm5e-coterie-field-label">Notas do Domínio</label>
            <textarea class="vtm5e-coterie-textarea" data-field="domainNotes" rows="4"
                      placeholder="Tamanho e limites, locais importantes, quem mais reivindica o domínio..." {{#unless isGM}}readonly{{/unless}}>{{domainNotes}}</textarea>
        </div>
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="backgrounds" hidden>
        <p class="vtm5e-coterie-tab-hint">Antecedentes compartilhados da coterie (livro básico, p. 196) — qualquer membro pode usá-los como seus.</p>
        <div class="vtm5e-coterie-background-list">
            {{#each backgrounds as |bg|}}
                <div class="vtm5e-coterie-background-row">
                    <span class="vtm5e-coterie-background-label">{{bg.label}}</span>
                    <div class="vtm5e-coterie-tracker-dots">
                        {{#each bg.dots as |dot|}}
                            <span class="vtm5e-coterie-tracker-dot {{#if dot.active}}active{{/if}}"
                                  {{#if ../../isGM}}data-action="setBackgroundRating" data-background-key="{{../bg.key}}" data-index="{{dot.index}}"{{/if}}></span>
                        {{/each}}
                    </div>
                    <input type="text" class="vtm5e-coterie-text-input vtm5e-coterie-background-note" data-background-note="{{bg.key}}" value="{{bg.note}}"
                           placeholder="Notas" {{#unless ../isGM}}readonly{{/unless}}>
                </div>
            {{/each}}
        </div>
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="meritsFlaws" hidden>
        {{#if meritsFlawsByMember.length}}
            {{#each meritsFlawsByMember as |group|}}
                <div class="vtm5e-coterie-member-group">
                    <h3 class="vtm5e-coterie-member-group-header">{{group.memberName}}</h3>
                    <div class="cs-mf-grid">
                        {{#each group.columns as |col|}}
                            <div class="cs-mf-column">
                                <div class="cs-mf-column-header">{{col.label}}</div>
                                {{#each col.items as |item|}}
                                    <div class="cs-expand-row">
                                        <div class="cs-expand-summary" data-action="toggleExpandRow">
                                            <span class="cs-power-name">{{item.name}} <span class="vtm5e-coterie-points">({{item.points}})</span></span>
                                            <span class="cs-expand-spacer"></span>
                                            <span class="cs-expand-caret"><i class="fas fa-chevron-down"></i></span>
                                        </div>
                                        <div class="cs-expand-detail">{{{item.description}}}</div>
                                    </div>
                                {{/each}}
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="vtm5e-coterie-empty">Nenhuma Qualidade, Defeito, Antecedente ou Favor encontrado entre os membros da coterie.</p>
        {{/if}}
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="equipment" hidden>
        {{#if equipmentByMember.length}}
            {{#each equipmentByMember as |group|}}
                <div class="vtm5e-coterie-member-group">
                    <h3 class="vtm5e-coterie-member-group-header">{{group.memberName}}</h3>
                    <div class="vtm5e-coterie-eq-list">
                        {{#each group.items as |item|}}
                            <div class="cs-expand-row">
                                <div class="cs-expand-summary" data-action="toggleExpandRow">
                                    <span class="cs-power-name">{{item.name}}</span>
                                    <span class="vtm5e-coterie-eq-slot">{{item.slotLabel}}</span>
                                    <span class="cs-expand-spacer"></span>
                                    <span class="cs-expand-caret"><i class="fas fa-chevron-down"></i></span>
                                </div>
                                <div class="cs-expand-detail">{{{item.description}}}</div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="vtm5e-coterie-empty">Nenhum equipamento vestido encontrado entre os membros da coterie.</p>
        {{/if}}
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="notes" hidden>
        <textarea class="vtm5e-coterie-textarea vtm5e-coterie-notes-textarea" data-field="notes"
                  placeholder="Notas gerais da coterie, planos, tramas..." {{#unless isGM}}readonly{{/unless}}>{{notes}}</textarea>
    </section>

    <section class="vtm5e-coterie-tab-content" data-tab-content="wishlist" hidden>
        {{#if isPlayerWishlist}}
            <p class="vtm5e-coterie-tab-hint">Privado — apenas você e o Narrador podem ver isto.</p>
            <button type="button" class="vtm5e-coterie-add-btn" data-action="addWishlistItem"><i class="fas fa-plus"></i> Adicionar à Lista de Desejos</button>
            {{#if wishlistItems.length}}
                <div class="vtm5e-coterie-wishlist-list">
                    {{#each wishlistItems as |item|}}
                        <div class="vtm5e-coterie-wishlist-row">
                            <span>{{item.text}}</span>
                            <a data-action="removeWishlistItem" data-wishlist-item-id="{{item.id}}" title="Remover">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="vtm5e-coterie-empty">Sua Lista de Desejos está vazia.</p>
            {{/if}}
        {{else}}
            <p class="vtm5e-coterie-tab-hint">Listas de Desejos privadas por jogador — visualização do Narrador. Cada jogador cria a sua no próprio cliente.</p>
            {{#if wishlists.length}}
                {{#each wishlists as |list|}}
                    <div class="vtm5e-coterie-member-group">
                        <h3 class="vtm5e-coterie-member-group-header">{{list.ownerName}}</h3>
                        {{#if list.items.length}}
                            <div class="vtm5e-coterie-wishlist-list">
                                {{#each list.items as |item|}}
                                    <div class="vtm5e-coterie-wishlist-row"><span>{{item.text}}</span></div>
                                {{/each}}
                            </div>
                        {{else}}
                            <p class="vtm5e-coterie-empty">Ainda não há itens.</p>
                        {{/if}}
                    </div>
                {{/each}}
            {{else}}
                <p class="vtm5e-coterie-empty">Ainda não há Listas de Desejos de jogadores — cada lista é criada quando o jogador abre esta aba pela primeira vez.</p>
            {{/if}}
        {{/if}}
    </section>
</div>
